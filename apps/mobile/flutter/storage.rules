rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile pictures - users can only upload/delete their own pictures
    match /profile_pictures/{fileName} {
      // Anyone can read profile pictures
      allow read: if true;
      
      // Only authenticated users can upload their own profile picture
      // Filename must contain their user ID
      allow write: if request.auth != null 
                   && fileName.matches('profile_' + request.auth.uid + '_.*');
      
      // Validate file size (max 5MB) and type (images only)
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      
      // Allow users to delete their own profile pictures
      allow delete: if request.auth != null
                    && fileName.matches('profile_' + request.auth.uid + '_.*');
    }
    
    // Chat media (photos, videos, documents shared in chats)
    match /chat_media/{chatId}/{fileName} {
      // Only authenticated users can read/write chat media
      allow read, write: if request.auth != null;
      
      // Validate file size (max 20MB for chat media)
      allow create: if request.auth != null
                    && request.resource.size < 20 * 1024 * 1024;
    }
    
    // Voice messages
    match /voice_messages/{chatId}/{fileName} {
      allow read, write: if request.auth != null;
      
      // Validate file size (max 10MB) and type (audio only)
      allow create: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
    }
    
    // Default deny for any other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
