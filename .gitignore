# ── Secrets & API keys ────────────────────────────────────────────────────────
.env.local
.env.production
.env.staging
*.env

# Firebase service account keys (never commit these)
*firebase-adminsdk*.json
*service-account*.json
*serviceaccount*.json

# Credentials vault directory (keys/*)
keys/*
!keys/README.md
!keys/*.example
!keys/*.example.*

# Flutter Firebase config files (contain API keys — regenerate with flutterfire configure)
apps/mobile/flutter/android/app/google-services.json
apps/mobile/flutter/ios/Runner/GoogleService-Info.plist
apps/mobile/flutter/lib/firebase_options.dart

# Web Firebase config (keep src/services/firebase.ts out if it has hardcoded keys)
# Uncomment the line below if you move keys to .env instead:
# apps/web/src/services/firebase.ts

# Android keystores / signing
*.jks
*.keystore
*.p12
key.properties
flutter/android/key.properties

