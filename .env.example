CLOUDINARY_CLOUD_NAME=your_cloud_name
# Local development: leave NODE_ENV as development. Production needs exact allowed origins.
NODE_ENV=development
# Slow HTTP requests are warned after this many milliseconds (default: 1000).
SLOW_REQUEST_LOG_THRESHOLD_MS=1000
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000
# Keep this exact value stable across every production deploy.
AUTH_SECRET=replace_with_a_long_random_secret
# Recommended on Render: configure MongoDB so accounts, chats, and login sessions survive deploys.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=novyn
# Local development only: relative paths are convenient but NOT durable in production.
DATA_DIR=./apps/api/runtime/data
# In production without MongoDB, set DATA_DIR to an absolute persistent-volume path,
# for example /var/data/novyn. Production startup rejects a relative fallback path.
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GIPHY_API_KEY=your_giphy_api_key
UPLOAD_TOKEN_SECRET=your_stable_upload_token_secret
# Local development only. Production requires Cloudinary or an absolute persistent upload path.
UPLOADS_DIR=./apps/api/runtime/uploads
# Without Cloudinary in production, use a mounted disk path such as /var/data/novyn-uploads.
VAPID_SUBJECT=mailto:admin@novyn.local
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
SMTP_FROM=Novyn <onboarding@resend.dev>
SMTP_REPLY_TO=support@your-domain.com
PASSWORD_RESET_EMAIL_SUBJECT=Your Novyn password reset code
EMAIL_CHANGE_EMAIL_SUBJECT=Verify your new Novyn email

# WebRTC — configure a private TURN relay for reliable calls across mobile/carrier networks.
# RTC_STUN_URLS accepts comma-separated URLs. For TURN, set all three values.
RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
RTC_TURN_URL=turns:turn.your-domain.com:443?transport=tcp
RTC_TURN_USERNAME=your_turn_username
RTC_TURN_CREDENTIAL=your_turn_credential
RTC_TURN_CREDENTIAL_TYPE=password

# Firebase Admin SDK credentials for the primary Firebase project
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# FIREBASE_SERVICE_ACCOUNT_FILE=./novynchat-firebase-adminsdk.json
# FIREBASE_PROJECT_ID=chat-novyn
# FIREBASE_CLIENT_EMAIL=novyn-api-admin@chat-novyn.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional during migration: old project's service account for legacy token verification,
# FCM delivery, and linked identity deletion.
# FIREBASE_LEGACY_SERVICE_ACCOUNT_JSON={...}

# Feedback — email address that receives submitted feedback
FEEDBACK_TO_EMAIL=you@yourdomain.com

# Firebase-hosted admin dashboard access and exact Hosting origins.
# ADMIN_EMAILS=admin@example.com
# ADMIN_ALLOWED_ORIGINS=https://chat-novyn.web.app,https://chat-novyn.firebaseapp.com

# Firebase Web SDK (frontend — Vite exposes VITE_ vars to the browser)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Persistence retry backoff (milliseconds; defaults: 500ms base, 30000ms max)
PERSISTENCE_RETRY_BASE_MS=500
PERSISTENCE_RETRY_MAX_MS=30000
