CLOUDINARY_CLOUD_NAME=your_cloud_name
# Local development: leave NODE_ENV as development. Production needs exact allowed origins.
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000
# Use a long random secret in production.
AUTH_SECRET=replace_with_a_long_random_secret
# Refresh sessions must survive redeploys, even with MongoDB enabled.
DATA_DIR=./data
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GIPHY_API_KEY=your_giphy_api_key
UPLOAD_TOKEN_SECRET=your_stable_upload_token_secret
UPLOADS_DIR=./uploads
VAPID_SUBJECT=mailto:admin@novyn.local
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
SMTP_FROM=Novyn <onboarding@resend.dev>
SMTP_REPLY_TO=support@your-domain.com
PASSWORD_RESET_EMAIL_SUBJECT=Your Novyn password reset code
EMAIL_CHANGE_EMAIL_SUBJECT=Verify your new Novyn email

# WebRTC — configure a private TURN relay for reliable calls across mobile/carrier networks.
# RTC_STUN_URLS accepts comma-separated URLs. For TURN, set all three values.
RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
RTC_TURN_URL=turns:turn.your-domain.com:443?transport=tcp
RTC_TURN_USERNAME=your_turn_username
RTC_TURN_CREDENTIAL=your_turn_credential
RTC_TURN_CREDENTIAL_TYPE=password

# Firebase Admin SDK credentials (optional if using the bundled service account file)
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# FIREBASE_SERVICE_ACCOUNT_FILE=./novynchat-firebase-adminsdk.json
# FIREBASE_PROJECT_ID=novyn-chat-app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@novyn-chat-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Feedback — email address that receives submitted feedback
FEEDBACK_TO_EMAIL=you@yourdomain.com

# Firebase Web SDK (frontend — Vite exposes VITE_ vars to the browser)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
