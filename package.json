{
  "name": "novyn-chat",
  "version": "1.0.0",
  "description": "Simple web chat app with friends and real-time messaging",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"node server.js\" \"vite\"",
    "dev:front": "vite",
    "dev:back": "node server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "migrate:state": "node scripts/migrate-state-to-mongo.js",
    "clear:data": "node scripts/clear-users.js",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:android": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "flutter:get": "cd flutter && flutter pub get",
    "flutter:run": "cd flutter && flutter run",
    "flutter:run:android": "cd flutter && flutter run -d android",
    "flutter:run:ios": "cd flutter && flutter run -d ios",
    "flutter:build:android": "cd flutter && flutter build apk --release",
    "flutter:build:ios": "cd flutter && flutter build ios --release",
    "flutter:build:appbundle": "cd flutter && flutter build appbundle --release",
    "flutter:codegen": "cd flutter && flutter pub run build_runner build --delete-conflicting-outputs",
    "flutter:clean": "cd flutter && flutter clean",
    "dev:all": "concurrently -n \"backend,web,flutter\" -c \"blue,green,magenta\" \"node server.js\" \"vite\" \"cd flutter && flutter run\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/network": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "cloudinary": "^2.9.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "mongodb": "^6.21.0",
    "multer": "^2.1.1",
    "nodemailer": "^10.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "tar": "file:vendor/capacitor-tar-compat",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "tar": "$tar",
    "uuid": "^11.1.1",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.2.1"
  }
}
